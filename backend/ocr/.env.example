# Django 설정
DJANGO_SECRET_KEY=django-insecure-change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Claude 설정
# 발급: https://platform.claude.com → API Keys. 비워 두면 분석 요청만 503 AI_UNAVAILABLE.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# 생각 깊이 low|medium|high|xhigh|max
CLAUDE_EFFORT=low
# 호출 시간 상한(초). WAS 의 OCR_TIMEOUT(기본 20초)보다 짧게
CLAUDE_TIMEOUT_SECONDS=15
CLAUDE_MAX_RETRIES=0
