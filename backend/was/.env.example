# 로컬 실행용 환경변수 예시. 복사해서 .env 로 쓰되 .env 는 커밋하지 않는다 (.gitignore 에 등록됨).
# IDE 실행 설정(Environment) 또는 `export` 로 넣으면 된다.

# --- AI (Gemini) ---------------------------------------------------------------------------
# 발급: https://aistudio.google.com → Get API key. 비워 두면 AI 기능만 503 AI_UNAVAILABLE.
GEMINI_API_KEY=
# 기본 모델과, 429(일일 한도)·장애일 때 넘어갈 예비 모델
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
# true 면 실제 호출 없이 가짜 응답 (키 없는 팀원의 로컬 실행용)
GEMINI_MOCK=false
# 5xx·타임아웃 재시도 횟수 (사용자 대기를 줄이려면 0)
GEMINI_MAX_RETRIES=1

# --- 영수증 OCR (RCPT-01) ------------------------------------------------------------------
# Django OCR 서버(backend/ocr) 주소. 비워 두면 Gemini 가 이미지를 직접 읽는다.
OCR_BASE_URL=
OCR_TIMEOUT=20s
