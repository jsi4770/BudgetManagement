# 로컬 실행용 환경변수 예시. 복사해서 .env 로 쓰되 .env 는 커밋하지 않는다 (.gitignore 에 등록됨).
# IDE 실행 설정(Environment) 또는 `export` 로 넣으면 된다.

# --- DB --------------------------------------------------------------------------------------
# 비워 두면 로컬 postgres(compose 의 postgres 서비스)를 씁니다. 외부 DB 를 쓸 때만 주석을 푸세요.
# 주석으로 둔 이유: Spring 은 **빈 값**도 설정된 것으로 보고 기본값을 버리므로, IDE 에서
# 이 파일을 그대로 불러오면 빈 DB_URL 로 부팅이 실패합니다.
# DB_URL=jdbc:postgresql://<host>:5432/<db>?sslmode=require
# DB_USERNAME=
# DB_PASSWORD=

# --- FRONT ---------------------------------------------------------------------------------
# CORS 허용 프론트 주소. 쉼표로 여러 개. 비우면 Vite 개발 서버(http://localhost:5173).
# FRONT_URL=http://localhost:5173,http://localhost:4173
# refresh_token 쿠키 SameSite (Strict | Lax | None). 기본 Lax.
# 프론트와 API 의 등록 도메인이 다를 때만 None (예: *.vercel.app ↔ *.onrender.com).
# COOKIE_SAME_SITE=None

# --- AI (Claude) ---------------------------------------------------------------------------
# 발급: https://platform.claude.com → API Keys. 비워 두면 AI 기능만 503 AI_UNAVAILABLE.
ANTHROPIC_API_KEY=
# 모델 (기본 claude-haiku-5-5)
# CLAUDE_MODEL=claude-haiku-5-5
# 429(한도)·장애일 때 넘어갈 예비 모델. 쓰지 않으면 주석으로 둔다
# CLAUDE_FALLBACK_MODEL=
# 사고 깊이 (low | medium | high | xhigh | max, 기본 low)
# CLAUDE_EFFORT=low
# true 면 실제 호출 없이 가짜 응답 (키 없는 팀원의 로컬 실행용)
CLAUDE_MOCK=false
# 5xx·타임아웃 재시도 횟수 (사용자 대기를 줄이려면 0)
CLAUDE_MAX_RETRIES=1

# --- 영수증 OCR (RCPT-01) ------------------------------------------------------------------
# Django OCR 서버(backend/ocr) 주소. 비워 두면 Claude 가 이미지를 직접 읽는다.
OCR_BASE_URL=
OCR_TIMEOUT=20s

# --- 지역화폐 가맹점 (한국조폐공사 통합 가맹점기본정보) --------------------------------------
# 공공데이터포털 활용신청 후 발급되는 서비스키. 비워 두면 가맹점 동기화만 건너뛰고 서버는 뜬다.
# 포털은 Encoding/Decoding 키 두 개를 주는데, 클라이언트가 URL 인코딩을 한 번 더 하므로 보통 Decoding 키를 쓴다.
MERCHANT_API_KEY=
# 기본값(https://apis.data.go.kr/B190001/localFranchisesV3)을 쓰려면 주석으로 둔다 — 빈 값은 기본값을 덮어쓴다.
# MERCHANT_API_BASE_URL=https://apis.data.go.kr/B190001/localFranchisesV3

# ── 온통청년 청년정책 API (홈 상단 정책 롤링) ───────────────────────────────
# 온통청년(youthcenter.go.kr) 오픈API 신청 후 발급된 인증키. 비워 두면 정책 동기화만 건너뛰고 서버는 뜬다.
YOUTH_POLICY_API_KEY=
# 기본값은 true: 부팅 때 정책 테이블이 비어 있을 때만 한 번 채운다(관리자 계정 없이 첫 적재).
# 가맹점(MERCHANT_SYNC_ON_START)도 같은 방식이며, 저장소의 CSV 로 빈 지역만 채운다. 끄려면 false.
# YOUTH_POLICY_SYNC_ON_START=true
# MERCHANT_SYNC_ON_START=true

# --- 시연용 더미 계정 (dev 프로필에서만) ---------------------------------------------------
# 부팅 때 dummy123@dummy123.com / dummy123! 계정이 없으면 만들고 시연 데이터(DELIVERY_SPIKE)를 깐다. 끄려면 false.
# DEMO_ACCOUNT_ENABLED=true
